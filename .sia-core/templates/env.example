# ─────────────────────────────────────────────────────────────
# SIA: modelo de variáveis de ambiente do projeto
#
# Usado por: @devops em *environment-bootstrap (copiado para .env.example na raiz do projeto).
# Copie para .env.local (Next.js) ou .env e preencha só o que o projeto usa.
# NUNCA versione o arquivo preenchido: .env, .env.local e .env.*.local ficam no .gitignore.
# Este modelo é versionado e fica sempre com todos os valores vazios.
# Em produção e preview, os valores vão para as variáveis de ambiente da Vercel (`vercel env add`)
# e, na CI, para os segredos do GitHub (`gh secret set`); nunca para arquivos do repositório.
# Prefixo NEXT_PUBLIC_: o valor é embutido no JavaScript enviado ao navegador. Use só para dado público.
# ─────────────────────────────────────────────────────────────

# ── Supabase: aplicação ──────────────────────────────────────
# URL do projeto (diálogo Connect ou Project Settings). Pública.
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...). Pública: o acesso fica limitado pelas políticas de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...). SÓ NO SERVIDOR: ignora o RLS. Nunca use prefixo público.
# Projetos antigos usam as chaves legadas anon e service_role, que o Supabase descontinua até o fim de 2026.
SUPABASE_SECRET_KEY=

# ── Supabase: CLI, MCP e CI ──────────────────────────────────
# Token pessoal com o menor escopo possível (painel do Supabase → Account → Access Tokens).
# Usado na CI e no MCP de clientes sem OAuth (header "Authorization: Bearer ...").
# Na máquina local, prefira `supabase login` e o login OAuth do MCP.
SUPABASE_ACCESS_TOKEN=
# Referência do projeto: o mesmo valor de integrations.supabase.projectRef no core-config.
SUPABASE_PROJECT_REF=

# ── Vercel (CI/CD) ───────────────────────────────────────────
# Token da Vercel (vercel.com/account/tokens), de preferência com escopo de projeto. Começa com vcp_.
# Na máquina local, prefira `vercel login`; na CI, use os segredos do GitHub.
VERCEL_TOKEN=
# orgId e projectId de .vercel/project.json (criado por `vercel link`). Os dois são exigidos juntos.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ── GitHub ───────────────────────────────────────────────────
# Token para o gh em ambiente sem login interativo. Na máquina local, prefira `gh auth login`.
GITHUB_TOKEN=

# ── Chaves de LLM (opcionais) ───────────────────────────────
# Só quando o projeto ou alguma IDE usa chave de API em vez de login por assinatura.
# Anthropic (Claude Code e SDK)
ANTHROPIC_API_KEY=
# OpenAI (Codex e SDK)
OPENAI_API_KEY=
# Google (Gemini CLI)
GEMINI_API_KEY=
# xAI (Grok Build)
XAI_API_KEY=
